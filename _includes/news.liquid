<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | sort: 'date' | reverse %}

    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
      {% assign show_year_separators = false %}
    {% else %}
      {% assign news_limit = news_size %}
      {% assign show_year_separators = true %}
    {% endif %}

    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 400px"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if show_year_separators %}
          {% assign current_year = nil %}
        {% endif %}

        {% for item in news limit: news_limit %}
          {% if show_year_separators %}
            {% assign item_year = item.date | date: '%Y' %}

            {% if current_year != item_year %}
              {% if current_year != nil %}
                <tr>
                  <td colspan="2" style="padding: 0;">
                    <hr style="margin: 10px 0; border-top: 2px solid #dee2e6;">
                  </td>
                </tr>
              {% endif %}

              <tr>
                <th colspan="2" style="font-size: 1.2em; font-weight: bold; padding-top: 15px;">
                  {{ item_year }}
                </th>
              </tr>

              {% assign current_year = item_year %}
            {% endif %}
          {% endif %}

          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>